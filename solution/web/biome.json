{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!test-results",
      "!playwright-report",
      "!fixtures/surfaces.json",
      "!tests/visual/__screenshots__"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all" } },
  "css": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": { "noStaticElementInteractions": "off", "useSemanticElements": "off", "noNoninteractiveTabindex": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
