# Copy to dev.tfvars (git-ignored) and fill in. Never commit real ids or secrets here.
subscription_id = "00000000-0000-0000-0000-000000000000"
environment     = "dev"
location        = "canadacentral"

# --- Models: settings.yaml at the solution root. Uncomment to override it for this environment only. ---
# model_deployments = { main = { model_name = "gpt-5.6-terra", model_version = "2026-07-09", sku_name = "GlobalStandard", capacity = 50 }, ... }
# model_roles       = { main = "main", memory = "memory", document = "document", embedding = "embedding" }
# cosmos_location   = "canadaeast" # only if the subscription cannot create Cosmos accounts in `location`

# --- Sizing ---
search_sku         = "standard2" # private ingestion of the knowledge source needs S2 or higher
search_replicas    = 1
enable_nat_gateway = false

# --- Container apps: false until the images exist in the registry (apply order in README) ---
deploy_apps = false
deploy_web  = false
# app_images = { bff = "<acr>.azurecr.io/bff:<sha>", "mcp-quoting" = "...", "mcp-a2ui" = "...", web = "..." }

# --- Principals (object ids) ---
# cicd_principal_id        = "<github-oidc-service-principal-object-id>"
# operators_group_id       = "<entra-group-object-id>"
# quote_agent_principal_id = "<instance_identity.principal_id of quote-agent, after the first agent deploy>"

# Deploying from a workstation instead of a runner in the VNet (dev only): your public IP.
# operator_ips = ["203.0.113.7/32"]

# After the entra stack: terraform -chdir=entra output client_ids
# mcp_client_ids = { "mcp-quoting" = "<client id>", "mcp-a2ui" = "<client id>" }
